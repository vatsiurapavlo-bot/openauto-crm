# --- Railway (główny sposób uruchomienia — docs/RAILWAY.md) ---
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# OPENAUTO_MASTER_KEY=<losowy klucz, min. 32 znaki — wygeneruj w CRM: Ustawienia>
# GOOGLE_CLIENT_ID=...  GOOGLE_CLIENT_SECRET=...
# BOOTSTRAP_OWNER_EMAIL=...  BOOTSTRAP_OWNER_NAME=...  BOOTSTRAP_OWNER_PASSWORD=<tymczasowe; usuń po 1. logowaniu>

# --- Docker Compose (własny serwer) ---
# Długie, losowe hasła, np.: openssl rand -base64 24
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Domena wskazująca na serwer (HTTPS przez Caddy), np. crm.openauto.pl
DOMAIN=
SESSION_TTL_HOURS=12
OPENAUTO_MASTER_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Uruchomienie bez Dockera / rozwój lokalny ---
# Aplikacja: rola BEZ prawa własności tabel (RLS działa)
DATABASE_URL=postgres://openauto_app:HASLO_APP@127.0.0.1:5432/openauto
# Migracje i setup: rola właściciela schematu
MIGRATION_DATABASE_URL=postgres://openauto_owner:HASLO_OWNER@127.0.0.1:5432/openauto
APP_DB_USER=openauto_app
APP_DB_PASSWORD=HASLO_APP
PORT=3000
# 1 = ciasteczka tylko przez HTTPS (domyślnie w produkcji)
SECURE_COOKIES=0
# 1 = aplikacja stoi za reverse proxy (X-Forwarded-For)
TRUST_PROXY=0

# --- Testy ---
# Połączenie z prawem tworzenia baz i ról (testy tworzą i usuwają własne bazy)
TEST_ADMIN_DATABASE_URL=postgres://postgres:HASLO@127.0.0.1:5432/postgres
